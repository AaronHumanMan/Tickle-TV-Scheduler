@page "/shows"
@using TickleTV.Scheduler.Core.Catalog
@using TickleTV.Scheduler.Web.Services
@inject CatalogAccess Catalog

<PageTitle>My shows</PageTitle>

<h1>My shows</h1>
<p class="lead">Every show Tickle TV found, with how many episodes it has and how long a typical episode runs. Episodes with chapter marks get commercial breaks between scenes; episodes without them play straight through and get commercials only at the end. The typical length is what the Schedule page uses to work out how many shows fit in a block of time.</p>

@if (rows.Count == 0)
{
    <div class="card"><p>No shows yet. Scan a folder that holds TV episodes first.</p></div>
}
else
{
    <table class="table">
        <thead><tr><th>Show</th><th>Episodes</th><th>Typical length</th><th>With chapter marks</th><th>With air dates</th></tr></thead>
        <tbody>
        @foreach (var r in rows)
        {
            <tr><td>@r.Show</td><td>@r.Episodes</td><td>@r.AvgMinutes min</td><td>@r.WithChapters</td><td>@r.WithDates</td></tr>
        }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<ShowSummary> rows = [];

    protected override void OnInitialized()
    {
        if (Catalog.CatalogExists) rows = Catalog.Run(db => db.ListShowSummaries());
    }
}
