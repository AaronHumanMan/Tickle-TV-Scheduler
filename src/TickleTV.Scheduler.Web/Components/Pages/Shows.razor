@page "/shows"
@using TickleTV.Scheduler.Core.Catalog
@using TickleTV.Scheduler.Web.Services
@inject CatalogAccess Catalog

<PageTitle>My shows</PageTitle>

<PageHead Title="My shows" Code="40274-04">Every show Tickle TV found, with how many episodes it has and how long a typical episode runs. Episodes with chapter marks get commercial breaks between scenes; episodes without them play straight through and get commercials only at the end. The typical length is what the Schedule page uses to work out how many shows fit in a block of time.</PageHead>

<section class="lower">
<SideRail Links="rail" />
<div class="lower-panels">
@if (rows.Count == 0)
{
    <div class="card"><p>No shows yet. Scan a folder that holds TV episodes first.</p></div>
}
else
{
    <table class="table">
        <thead><tr><th>Show</th><th>Episodes</th><th>Typical length</th><th>With chapter marks</th><th>With air dates</th><th>Holiday episodes</th></tr></thead>
        <tbody>
        @foreach (var r in rows)
        {
            <tr><td>@r.Show</td><td>@r.Episodes</td><td>@r.AvgMinutes min</td><td>@r.WithChapters</td><td>@r.WithDates</td><td>@HolidayWords(r)</td></tr>
        }
        </tbody>
    </table>
}
</div>
</section>

@code {
    private static readonly IReadOnlyList<SideRail.Link> rail =
    [
        new("Library", "library", 1),
        new("Schedule", "schedule", 2),
        new("Needs attention", "review", 3),
        new("Help", "help"),
    ];

    private static string HolidayWords(ShowSummary r) => r.Holidays.Count == 0 ? "" :
        string.Join(", ", r.Holidays.OrderByDescending(kv => kv.Value).Select(kv => $"{HolidayTagger.Name(kv.Key)} {kv.Value}"));

    private IReadOnlyList<ShowSummary> rows = [];

    protected override void OnInitialized()
    {
        if (Catalog.CatalogExists) rows = Catalog.Run(db => db.ListShowSummaries());
    }
}
