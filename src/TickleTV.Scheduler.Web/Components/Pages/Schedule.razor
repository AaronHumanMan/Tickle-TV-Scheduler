@page "/schedule"
@using TickleTV.Scheduler.Core.Catalog
@using TickleTV.Scheduler.Core.Config
@using TickleTV.Scheduler.Core.Engine
@using TickleTV.Scheduler.Web.Services
@inject ConfigStore Config
@inject CatalogAccess Catalog
@rendermode InteractiveServer

<PageTitle>Schedule</PageTitle>

<PageHead Title="My daily schedule" Code="40274-07">This is the grid your channels follow each day. Each time slot plays episodes back to back until the next slot starts. A slot can hold one show, or several that take turns (a block). A channel can have more than one grid, called a <strong>day plan</strong> (Normal Day, Weekend, Christmas); the <a href="calendar">Calendar</a> page says which dates use which. Change anything, press <strong>Save</strong>, then go to <a href="build">Build</a> to put it on air.</PageHead>

<section class="lower">
<SideRail Links="rail" />
<div class="lower-panels">
@if (cfg is null)
{
    <div class="card warn"><p>@notice</p></div>
}
else
{
    <div class="view-toggle">
        <span class="muted">Show as</span>
        <button class="chip @(view == "grid" ? "active" : "")" data-sound="keyok" @onclick="@(() => SetView("grid"))">Guide grid</button>
        <button class="chip @(view == "list" ? "active" : "")" data-sound="keyok" @onclick="@(() => SetView("list"))">Lists</button>
    </div>

    @if (view == "grid")
    {
        <div class="card">
            <h2>All channels</h2>
            <ScheduleGrid Channels="cfg.Channels" Expandable="true" Expanded="expanded" OnToggle="Toggle" PlanOf="Selected">
                <ChildContent Context="ch">@ChannelEditor(ch)</ChildContent>
            </ScheduleGrid>
            <p class="muted">Press <strong>edit</strong> on a channel to change its slots and settings.</p>
        </div>
    }
    else
    {
        @foreach (var ch in cfg.Channels)
        {
            <div class="card">
                <h2>Channel @ch.Number: @ch.Name</h2>
                @ChannelEditor(ch)
            </div>
        }
    }

    <div class="actions save-row">
        <button class="button primary" data-sound="keyok" @onclick="Save">Save schedule</button>
        <a class="button secondary" href="build" data-sound="keyok">Go to Build</a>
        <a class="button secondary" href="channels" data-sound="keyok">Add a channel</a>
    </div>
    @if (!string.IsNullOrEmpty(notice)) { <div class="notice">@notice</div> }
    @if (problems.Count > 0)
    {
        <div class="card warn"><ul>@foreach (string p in problems) { <li>@p</li> }</ul></div>
    }
}
</div>
</section>

@code {
    private static readonly IReadOnlyList<SideRail.Link> rail =
    [
        new("Calendar", "calendar", 1),
        new("Build", "build", 2),
        new("Channels", "channels", 3),
        new("Help", "help"),
    ];
    private SchedulerConfig? cfg;
    private IReadOnlyList<string> shows = [];
    private Dictionary<string, long> lengths = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, IReadOnlyDictionary<string, int>> holidayCounts = new(StringComparer.OrdinalIgnoreCase);
    private string? notice;
    private List<string> problems = [];
    private string view = "list";
    private readonly HashSet<string> expanded = new();
    private readonly Dictionary<string, string> holdGrid = new();
    private readonly Dictionary<string, string> selectedPlan = new();
    private readonly Dictionary<string, string> newNames = new();

    private DayPlan Selected(ChannelConfig ch) =>
        (selectedPlan.TryGetValue(ch.Number, out string? name) ? ch.FindPlan(name) : null) ?? ch.Default;

    private void Select(ChannelConfig ch, string? name) { if (name is not null) selectedPlan[ch.Number] = name; }

    private string NewName(ChannelConfig ch) => newNames.TryGetValue(ch.Number, out string? n) ? n : string.Empty;

    private readonly Dictionary<string, string> pending = new();

    private string? Pending(ChannelConfig ch) => pending.TryGetValue(ch.Number, out string? a) ? a : null;

    private void Begin(ChannelConfig ch, string action)
    {
        pending[ch.Number] = action;
        newNames[ch.Number] = action == "rename" ? Selected(ch).Name : string.Empty;
        notice = null;
    }

    /// <summary>Carries out the pending rename, copy or blank plan with the name typed in the small form.</summary>
    private void Finish(ChannelConfig ch, DayPlan plan)
    {
        string? action = Pending(ch);
        if (action is null) return;
        string name = NewName(ch).Trim();
        if (name.Length == 0) { notice = "Type a name first, such as Weekend or Christmas."; return; }
        DayPlan? clash = ch.FindPlan(name);
        if (clash is not null && !(action == "rename" && ReferenceEquals(clash, plan))) { notice = $"There is already a day plan called \"{name}\". Pick another name."; return; }

        switch (action)
        {
            case "rename":
                ch.RenamePlan(plan, name);
                selectedPlan[ch.Number] = plan.Name;
                notice = $"Renamed to \"{name}\". Press Save schedule to keep it.";
                break;
            case "copy":
                DayPlan copy = plan.Copy(name);
                foreach (var s in copy.Slots) if (s.Shows.Count == 0) s.Shows.Add(string.Empty);
                ch.Plans.Add(copy);
                selectedPlan[ch.Number] = name;
                notice = $"\"{name}\" is a copy of \"{plan.Name}\". Change its slots, press Save schedule, then tell the Calendar page when to use it.";
                break;
            default:
                ch.Plans.Add(new DayPlan { Name = name, Slots = [new SlotConfig { Time = "06:00", Shows = [shows.FirstOrDefault() ?? ""], Order = "chronological" }] });
                selectedPlan[ch.Number] = name;
                notice = $"\"{name}\" starts with one slot. Add more, press Save schedule, then tell the Calendar page when to use it.";
                break;
        }
        pending.Remove(ch.Number);
        newNames[ch.Number] = string.Empty;
    }

    private void DeletePlan(ChannelConfig ch, DayPlan plan)
    {
        if (ch.Plans.Count < 2) return;
        ch.RemovePlan(plan);
        selectedPlan.Remove(ch.Number);
        notice = $"\"{plan.Name}\" is gone, along with any calendar rules that used it. Press Save to make it final.";
    }

    private static string UsedWords(ChannelConfig ch, DayPlan plan)
    {
        var rules = ch.Calendar.Where(r => string.Equals(r.Plan, plan.Name, StringComparison.OrdinalIgnoreCase)).Select(PlanCalendar.Describe).ToList();
        bool ordinary = ReferenceEquals(plan, ch.Default);
        if (ordinary && rules.Count == 0) return ch.Plans.Count > 1 ? "Used on every day that no calendar rule claims." : "Used every day.";
        if (ordinary) return "Used on ordinary days, and on " + string.Join("; ", rules) + ".";
        if (rules.Count == 0) return "Not used on any date yet.";
        return "Used on " + string.Join("; ", rules) + ".";
    }

    private RenderFragment ChannelEditor(ChannelConfig ch) => __builder =>
    {
        var plan = Selected(ch);
        <h3>Day plan</h3>
        <div class="plan-bar">
            <label class="inline">Editing
                <select value="@plan.Name" @onchange="e => Select(ch, e.Value?.ToString())">
                    @foreach (var p in ch.Plans) { <option value="@p.Name">@p.Name@(ReferenceEquals(p, ch.Default) ? " (ordinary days)" : "")</option> }
                </select>
            </label>
            <button class="button secondary" data-sound="keyok" @onclick='() => Begin(ch, "rename")'>Rename this plan</button>
            <button class="button" data-sound="keyok" @onclick='() => Begin(ch, "copy")'>Make a copy of this plan</button>
            <button class="button secondary" data-sound="keyok" @onclick='() => Begin(ch, "blank")'>Start a blank plan</button>
            @if (!ReferenceEquals(plan, ch.Default)) { <button class="link" @onclick="() => ch.DefaultPlan = plan.Name">use this on ordinary days</button> }
            @if (ch.Plans.Count > 1) { <button class="link" @onclick="() => DeletePlan(ch, plan)">delete this plan</button> }
        </div>
        @if (Pending(ch) is { } action)
        {
            <div class="plan-bar plan-form">
                <label class="inline">@(action == "rename" ? "New name for this plan" : action == "copy" ? $"Call the copy of \"{plan.Name}\"" : "Call the new plan")
                    <input value="@NewName(ch)" @oninput="e => newNames[ch.Number] = e.Value?.ToString() ?? string.Empty" @onkeydown='e => { if (e.Key == "Enter") Finish(ch, plan); }' placeholder="Weekend" />
                </label>
                <button class="button primary" data-sound="keyok" @onclick="() => Finish(ch, plan)">@(action == "rename" ? "Rename" : action == "copy" ? "Create the copy" : "Create the plan")</button>
                <button class="link" @onclick="() => pending.Remove(ch.Number)">cancel</button>
            </div>
        }
        <p class="muted">@UsedWords(ch, plan) <a href="calendar">Change on the Calendar page.</a></p>

        <h3>Time slots</h3>
        @if (plan.Slots.Count == 0)
        {
            <p>No slots yet. Add one below.</p>
        }
        else
        {
            <div class="table-wrap">
            <table class="table schedule">
                <colgroup><col class="c-time" /><col class="c-show" /><col class="c-order" /><col class="c-pad" /><col class="c-breaks" /><col class="c-remove" /></colgroup>
                <thead><tr><th>Starts at</th><th>Show, or shows that take turns</th><th>Episode order</th><th>Each show ends on</th><th>Breaks inside each episode<br /><span class="th-note">needs chapter marks; blank = channel setting</span></th><th></th></tr></thead>
                <tbody>
                @foreach (var slot in plan.Slots.OrderBy(s => s.Time).ToList())
                {
                    <tr>
                        <td><input type="time" value="@slot.Time" @onchange="e => slot.Time = e.Value?.ToString() ?? slot.Time" /></td>
                        <td class="show-cell">
                            @for (int i = 0; i < slot.Shows.Count; i++)
                            {
                                int idx = i;
                                <div class="show-row">
                                    <SearchSelect Options="shows" Value="@slot.Shows[idx]" ValueChanged="@(v => slot.Shows[idx] = v)" Placeholder="Pick a show" AddLabel="Use the name I typed" />
                                    <span class="len">@LengthWords(slot.Shows[idx])</span>
                                    @if (slot.Shows.Count > 1) { <button class="link" title="Take this show out of the block" @onclick="() => slot.Shows.RemoveAt(idx)">remove</button> }
                                </div>
                            }
                            <button class="link" @onclick="() => slot.Shows.Add(string.Empty)">+ add another show to this slot</button>
                            @if (slot.Shows.Count > 1)
                            {
                                <label class="turns">Which show plays next:
                                    <select value="@(slot.Turns ?? "in_order")" @onchange="e => slot.Turns = NullIfEmpty(e.Value)">
                                        <option value="in_order">Take turns in the order listed above</option>
                                        <option value="random">Pick at random (never the same show twice in a row)</option>
                                    </select>
                                </label>
                            }
                            <label class="turns">Holiday episodes:
                                <select value="@(slot.HolidayEpisodes ?? "any")" @onchange="e => SetHolidayMode(slot, e.Value?.ToString())">
                                    <option value="any">Any episode (no holiday rule)</option>
                                    <option value="first">Holiday episodes first, then the rest</option>
                                    <option value="only">Holiday episodes only</option>
                                </select>
                                @if (slot.HolidayMode != HolidayMode.Any)
                                {
                                    <select value="@(slot.Holiday ?? "christmas")" @onchange="e => slot.Holiday = e.Value?.ToString()">
                                        @foreach (var h in HolidayTagger.Choices) { <option value="@h.Key">@h.Name</option> }
                                    </select>
                                }
                            </label>
                            @if (slot.HolidayMode != HolidayMode.Any && HolidayCountWords(slot) is { } hc) { <p class="block-note">@hc</p> }
                            <label class="turns">Commercials:
                                <select value="@AdMode(slot)" @onchange="e => SetAdMode(slot, e.Value?.ToString())">
                                    <option value="any">Any category</option>
                                    <option value="only">Only these categories</option>
                                    <option value="never">Any except these categories</option>
                                </select>
                            </label>
                            @if (AdMode(slot) != "any")
                            {
                                var picked = AdMode(slot) == "only" ? slot.Ads!.Only : slot.Ads!.Never;
                                <div class="cat-list">
                                    @foreach (var c in categories)
                                    {
                                        <label class="check"><input type="checkbox" checked="@picked.Contains(c.Slug)" @onchange="() => ToggleCategory(slot, picked, c.Slug)" /> @c.Name <span class="muted">(@c.Items)</span></label>
                                    }
                                    <label class="check"><input type="checkbox" checked="@picked.Contains(AdRules.NoCategory)" @onchange="() => ToggleCategory(slot, picked, AdRules.NoCategory)" /> No category yet <span class="muted">(@noCategory)</span></label>
                                </div>
                                @if (AdCountWords(slot) is { } ac) { <p class="block-note">@ac</p> }
                            }
                            <label class="turns">Commercial years:
                                <select value="@EraModeOf(slot)" @onchange="e => SetEraMode(slot, e.Value?.ToString())">
                                    <option value="any">Any year</option>
                                    <option value="show">From around when the episode aired</option>
                                    <option value="decades">Only these decades</option>
                                </select>
                            </label>
                            @if (EraModeOf(slot) == "show")
                            {
                                <label class="turns">Within <input type="number" min="0" max="50" class="short" value="@slot.Ads!.EraSpan" @onchange="e => SetEraSpan(slot, e.Value?.ToString())" /> years of the episode's year</label>
                                @if (EraCountWords(slot) is { } ew) { <p class="block-note">@ew</p> }
                            }
                            else if (EraModeOf(slot) == "decades")
                            {
                                <div class="cat-list">
                                    @foreach (var d in decades)
                                    {
                                        <label class="check"><input type="checkbox" checked="@slot.Ads!.Decades.Contains(d.Tag)" @onchange="() => ToggleDecade(slot, d.Tag)" /> @d.Tag <span class="muted">(@d.Items)</span></label>
                                    }
                                    @if (decades.Count == 0) { <p class="muted">No commercial has a year or a decade yet. A folder named <em>80s</em> or <em>90s</em>, or a year in the file name, gives them one when you scan.</p> }
                                </div>
                                @if (EraCountWords(slot) is { } ew) { <p class="block-note">@ew</p> }
                            }
                            <label class="turns">Holiday commercials:
                                <select value="@HolidayAdsOf(slot)" @onchange="e => SetHolidayAds(slot, e.Value?.ToString())">
                                    <option value="none">No holiday rule</option>
                                    <option value="mix">Mix them in (about half of each break)</option>
                                    <option value="only">Holiday commercials only</option>
                                </select>
                                @if (HolidayAdsOf(slot) != "none")
                                {
                                    <select value="@(slot.Ads!.Holiday ?? SlotAdsConfig.CalendarHoliday)" @onchange="e => SetHolidayAdsKey(slot, e.Value?.ToString())">
                                        <option value="@SlotAdsConfig.CalendarHoliday">Whatever holiday the Calendar gives the day</option>
                                        @foreach (var h in HolidayTagger.Choices) { <option value="@h.Key">@h.Name</option> }
                                    </select>
                                }
                            </label>
                            @if (HolidayAdsWords(ch, slot) is { } hw) { <p class="block-note">@hw</p> }
                            @if (BlockAdvisor.Advice(ch, slot, AverageOf) is { } advice) { <p class="block-note">@advice</p> }
                        </td>
                        <td>
                            <select @bind="slot.Order">
                                <option value="chronological">In order (by air date)</option>
                                <option value="shuffle">Shuffled, no repeats</option>
                            </select>
                        </td>
                        <td>
                            <select value="@(slot.Pad ?? "")" @onchange="e => slot.Pad = NullIfEmpty(e.Value)">
                                <option value="">Channel default (@PadWords(ch.Defaults.Pad))</option>
                                <option value="30">The half hour</option>
                                <option value="60">The hour</option>
                                <option value="10">The next 10 minutes</option>
                                <option value="5">The next 5 minutes</option>
                                <option value="none">When the show ends</option>
                            </select>
                        </td>
                        <td><input type="number" min="0" max="8" value="@slot.MaxBreaks" placeholder="@ch.Defaults.MaxBreaks" @onchange="e => slot.MaxBreaks = int.TryParse(e.Value?.ToString(), out int n) ? n : null" /></td>
                        <td><button class="link" @onclick="() => plan.Slots.Remove(slot)">remove</button></td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }
        <div class="actions">
            <button class="button" data-sound="keyok" @onclick="() => AddSlot(plan)">Add a time slot</button>
        </div>

        <h3>Channel settings</h3>
        <div class="form">
            <label>Channel name <input @bind="ch.Name" /></label>
            <label>Shows end on (unless a slot says otherwise)
                <select @bind="ch.Defaults.Pad">
                    <option value="30">The half hour</option>
                    <option value="60">The hour</option>
                    <option value="10">The next 10 minutes</option>
                    <option value="5">The next 5 minutes</option>
                    <option value="none">When the show ends</option>
                </select>
            </label>
            <label>Commercial breaks inside each episode <span class="muted small">(needs chapter marks; the commercial time stays the same, this is how many breaks it is split into)</span> <input type="number" min="0" max="8" @bind="ch.Defaults.MaxBreaks" /></label>
            <label>Don't repeat a commercial within (minutes) <input type="number" min="0" max="1440" @bind="ch.Ads.CooldownMinutes" /></label>
            <div class="cat-block">
                <span class="label">Never air these categories anywhere on this channel</span>
                @if (categories.Count == 0)
                {
                    <p class="muted">No categories yet. Folders like <em>90s\Cars</em> become categories when you scan, or add some on the Categories page.</p>
                }
                else
                {
                    <div class="cat-list">
                        @foreach (var c in categories)
                        {
                            <label class="check"><input type="checkbox" checked="@ch.Ads.Never.Contains(c.Slug)" @onchange="() => ToggleChannelNever(ch, c.Slug)" /> @c.Name <span class="muted">(@c.Items)</span></label>
                        }
                        <label class="check"><input type="checkbox" checked="@ch.Ads.Never.Contains(AdRules.NoCategory)" @onchange="() => ToggleChannelNever(ch, AdRules.NoCategory)" /> No category yet <span class="muted">(@noCategory)</span></label>
                    </div>
                }
            </div>
            <label>Bumpers
                <select @bind="ch.Bumpers.Placement">
                    <option value="show_edges">One before the show and one after it</option>
                    <option value="every_break">Around the commercials in every break</option>
                </select>
            </label>
            <label>Start every slot on time
                <select value="@HoldGrid(ch)" @onchange="e => SetHoldGrid(ch, e)">
                    <option value="true">Yes: fill short leftovers with promos and commercials</option>
                    <option value="false">No: let shows run over and start the next slot late</option>
                </select>
            </label>
            <label>Longest leftover to fill that way (minutes) <input type="number" min="1" max="60" @bind="ch.Gap.MaxMinutes" /></label>
        </div>
    };

    protected override void OnInitialized()
    {
        try
        {
            cfg = Config.LoadLoose();
            if (cfg.Channels.Count == 0)
                cfg.Channels.Add(new ChannelConfig { Number = "1", Name = "Tickle TV", TvgId = "tickle.1" });
            foreach (var c in cfg.Channels) c.NormalizePlans();
            foreach (var slot in cfg.Channels.SelectMany(c => c.Plans.SelectMany(p => p.Slots)))
            {
                slot.Normalize();
                if (slot.Shows.Count == 0) slot.Shows.Add(string.Empty);
            }
            view = cfg.Ui.ScheduleView == "grid" ? "grid" : "list";
        }
        catch (Exception ex)
        {
            notice = "I couldn't read the settings file: " + ex.Message;
        }
        if (Catalog.CatalogExists)
        {
            var summaries = Catalog.Run(db => db.ListShowSummaries());
            shows = summaries.Select(s => s.Show).ToList();
            lengths = summaries.ToDictionary(s => s.Show, s => s.AvgDurationMs, StringComparer.OrdinalIgnoreCase);
            holidayCounts = summaries.ToDictionary(s => s.Show, s => s.Holidays, StringComparer.OrdinalIgnoreCase);
            categories = Catalog.Run(db => db.ListCategories());
            noCategory = Catalog.Run(db => db.CountCommercials([AdRules.NoCategory], []));
            decades = Catalog.Run(db => db.ListDecades());
            holidayAdCounts = Catalog.Run(db => db.CountHolidayCommercials());
        }
    }

    // ----- Holiday commercials per slot

    private IReadOnlyDictionary<string, int> holidayAdCounts = new Dictionary<string, int>();

    private static string HolidayAdsOf(SlotConfig slot) => slot.Ads?.HolidayAdsMode switch
    {
        HolidayAdsMode.Mix => "mix",
        HolidayAdsMode.Only => "only",
        _ => "none",
    };

    private void SetHolidayAds(SlotConfig slot, string? mode)
    {
        slot.Ads ??= new SlotAdsConfig();
        if (mode is "mix" or "only")
        {
            slot.Ads.Holiday ??= SlotAdsConfig.CalendarHoliday;
            slot.Ads.HolidayAds = mode;
        }
        else
        {
            slot.Ads.Holiday = null;
            slot.Ads.HolidayAds = null;
        }
        TidyAds(slot);
    }

    private static void SetHolidayAdsKey(SlotConfig slot, string? key)
    {
        if (slot.Ads is null) return;
        slot.Ads.Holiday = string.IsNullOrWhiteSpace(key) ? SlotAdsConfig.CalendarHoliday : key;
    }

    /// <summary>What the holiday rule will do with this catalog and this channel's calendar, in plain words.</summary>
    private string? HolidayAdsWords(ChannelConfig ch, SlotConfig slot)
    {
        if (slot.Ads is null || slot.Ads.HolidayAdsMode == HolidayAdsMode.None || !Catalog.CatalogExists) return null;
        bool only = slot.Ads.HolidayAdsMode == HolidayAdsMode.Only;
        string Tagged(string key) => holidayAdCounts.TryGetValue(key, out int n) ? n.ToString("N0") : "0";
        if (slot.Ads.Holiday == SlotAdsConfig.CalendarHoliday)
        {
            var rules = ch.Calendar.Where(r => r.Kind == RuleKind.Holiday && r.Holiday is not null).Select(r => HolidayTagger.Fold(r.Holiday!)).Distinct().ToList();
            if (rules.Count == 0) return "This channel's Calendar has no holiday rules yet, so this does nothing until you add one there. On any other day the slot plays its usual commercials.";
            string counts = string.Join(", ", rules.Select(k => $"{HolidayTagger.Name(k)} {Tagged(k)}"));
            return $"On the days the Calendar gives to a holiday, that holiday's commercials {(only ? "are all that air" : "fill about half of each break")}; other days are normal. Tagged commercials: {counts}.";
        }
        string name = HolidayTagger.Name(slot.Ads.Holiday!);
        int have = holidayAdCounts.GetValueOrDefault(slot.Ads.Holiday!);
        if (have == 0) return $"No commercial is tagged {name} yet, so this slot plays its usual commercials. The scan tags them from words in the file name; you can also label them on the Library page.";
        if (only && have < AdRules.SmallPool) return $"Only {have} {name} commercial{(have == 1 ? "" : "s")} are tagged. They will repeat a lot, and breaks fall back to other commercials when they run out.";
        return $"{have:N0} {name} commercials are tagged and {(only ? "nothing else airs in this slot while they last" : "about half of each break comes from them")}.";
    }

    // ----- Commercial categories per slot

    private IReadOnlyList<CatalogDb.Category> categories = [];
    private int noCategory;
    private readonly Dictionary<SlotConfig, string> adModes = new(ReferenceEqualityComparer.Instance);
    private readonly Dictionary<SlotConfig, int> adCounts = new(ReferenceEqualityComparer.Instance);

    /// <summary>any, only or never: what the person chose for this slot, or what its saved rule implies.</summary>
    private string AdMode(SlotConfig slot)
    {
        if (adModes.TryGetValue(slot, out string? mode)) return mode;
        if (slot.Ads is null) return "any";
        return slot.Ads.Only.Count > 0 ? "only" : slot.Ads.Never.Count > 0 ? "never" : "any";
    }

    private void SetAdMode(SlotConfig slot, string? mode)
    {
        mode = mode is "only" or "never" ? mode : "any";
        adModes[slot] = mode;
        slot.Ads ??= new SlotAdsConfig();
        if (mode != "only") slot.Ads.Only.Clear();
        if (mode != "never") slot.Ads.Never.Clear();
        TidyAds(slot);
        RecountAds(slot);
    }

    /// <summary>Drops the rule object once nothing is set, so the saved file stays as it was.</summary>
    private void TidyAds(SlotConfig slot)
    {
        if (slot.Ads is { IsEmpty: true } && AdMode(slot) == "any") slot.Ads = null;
    }

    private void ToggleCategory(SlotConfig slot, List<string> picked, string slug)
    {
        if (!picked.Remove(slug)) picked.Add(slug);
        RecountAds(slot);
    }

    private static void ToggleChannelNever(ChannelConfig ch, string slug)
    {
        if (!ch.Ads.Never.Remove(slug)) ch.Ads.Never.Add(slug);
    }

    private void RecountAds(SlotConfig slot)
    {
        if (slot.Ads is null || !Catalog.CatalogExists) { adCounts.Remove(slot); return; }
        adCounts[slot] = Catalog.Run(db => db.CountCommercials(slot.Ads.Only, slot.Ads.Never, slot.Ads.EraMode == EraMode.Decades ? slot.Ads.Decades : null));
    }

    // ----- Commercial years per slot

    private IReadOnlyList<CatalogDb.Decade> decades = [];
    private readonly Dictionary<string, CatalogDb.ShowYears> showYears = new(StringComparer.OrdinalIgnoreCase);

    private static string EraModeOf(SlotConfig slot) => slot.Ads?.EraMode switch
    {
        EraMode.Show => "show",
        EraMode.Decades => "decades",
        _ => "any",
    };

    private void SetEraMode(SlotConfig slot, string? mode)
    {
        slot.Ads ??= new SlotAdsConfig();
        slot.Ads.Era = mode is "show" or "decades" ? mode : null;
        if (mode != "decades") slot.Ads.Decades.Clear();
        if (mode != "show") slot.Ads.EraWithin = null;
        TidyAds(slot);
        RecountAds(slot);
    }

    private static void SetEraSpan(SlotConfig slot, string? text)
    {
        if (slot.Ads is null) return;
        slot.Ads.EraWithin = int.TryParse(text, out int n) ? Math.Clamp(n, 0, 50) : null;
    }

    private void ToggleDecade(SlotConfig slot, string tag)
    {
        if (slot.Ads is null) return;
        if (!slot.Ads.Decades.Remove(tag)) slot.Ads.Decades.Add(tag);
        RecountAds(slot);
    }

    private CatalogDb.ShowYears? ShowYearsOf(string show)
    {
        if (!Catalog.CatalogExists || string.IsNullOrWhiteSpace(show)) return null;
        if (!showYears.TryGetValue(show, out var years))
            showYears[show] = years = Catalog.Run(db => db.YearsOfShow(show));
        return years;
    }

    /// <summary>What the slot's year rule means for its shows and commercials, in plain words.</summary>
    private string? EraCountWords(SlotConfig slot)
    {
        if (slot.Ads is null || !Catalog.CatalogExists) return null;
        string fit = AdMode(slot) == "any" ? "" : " and fit the categories above";
        if (slot.Ads.EraMode == EraMode.Decades)
        {
            if (slot.Ads.Decades.Count == 0) return "Tick at least one decade, or this slot will use commercials from any year.";
            if (!adCounts.TryGetValue(slot, out int n)) { RecountAds(slot); n = adCounts.GetValueOrDefault(slot); }
            string from = "the " + string.Join(", ", slot.Ads.Decades);
            if (n < AdRules.SmallPool) return $"Only {n} commercial{(n == 1 ? "" : "s")} come from {from}{fit}. {(n == 0 ? "The breaks will use any commercial instead." : "They will repeat a lot, and breaks fall back to any commercial when they run out.")}";
            return $"{n:N0} commercials come from {from}{fit}.";
        }
        if (slot.Ads.EraMode == EraMode.Show)
        {
            var parts = new List<string>();
            foreach (string show in slot.ShowList.Where(s => !string.IsNullOrWhiteSpace(s)))
            {
                if (ShowYearsOf(show) is not { } y) continue;
                if (y.Dated == 0) parts.Add($"{show} episodes have no year or air date, so they take commercials from any year.");
                else
                {
                    string span = y.First == y.Last ? $"{y.First}" : $"{y.First} to {y.Last}";
                    string undated = y.Dated < y.Episodes ? $" ({y.Episodes - y.Dated} without a date take any year)" : "";
                    parts.Add($"{show} episodes are from {span}{undated}.");
                }
            }
            int dated = Catalog.Run(db => db.CountCommercials(slot.Ads.Only, slot.Ads.Never, null, datedOnly: true));
            parts.Add(dated == 0
                ? "No commercial has a year or a decade yet, so breaks will use any commercial. A folder named 80s or 90s, or a year in the file name, gives them one when you scan."
                : $"{dated:N0} commercials have a year or decade to match on{fit}; the rest only air when the matched ones run out.");
            return string.Join(" ", parts);
        }
        return null;
    }

    private string? AdCountWords(SlotConfig slot)
    {
        if (slot.Ads is null) return null;
        bool only = AdMode(slot) == "only";
        var picked = only ? slot.Ads.Only : slot.Ads.Never;
        if (picked.Count == 0) return only ? "Tick at least one category, or this slot will use any commercial." : "Tick the categories to keep out of this slot.";
        if (!adCounts.TryGetValue(slot, out int n)) RecountAds(slot);
        n = adCounts.TryGetValue(slot, out int m) ? m : 0;
        if (only && n < AdRules.SmallPool) return $"Only {n} commercial{(n == 1 ? "" : "s")} match. {(n == 0 ? "The breaks will use any commercial instead." : "They will repeat a lot, and breaks fall back to any commercial when they run out.")}";
        return $"{n:N0} commercials can air in this slot.";
    }

    private long? AverageOf(string show) => lengths.TryGetValue(show, out long ms) ? ms : null;

    private static void SetHolidayMode(SlotConfig slot, string? mode)
    {
        slot.HolidayEpisodes = mode is "first" or "only" ? mode : null;
        if (slot.HolidayEpisodes is null) slot.Holiday = null;
        else slot.Holiday ??= "christmas";
    }

    /// <summary>"Good Eats has 1 Christmas Day episode, Modern Marvels has 2", or a warning when none of the slot's shows has any.</summary>
    private string? HolidayCountWords(SlotConfig slot)
    {
        string holiday = slot.Holiday ?? "christmas";
        string name = HolidayTagger.Name(holiday);
        var parts = new List<string>();
        int total = 0;
        foreach (string show in slot.ShowList.Where(s => !string.IsNullOrWhiteSpace(s)))
        {
            int n = holidayCounts.TryGetValue(show, out var per) && per.TryGetValue(holiday, out int c) ? c : 0;
            total += n;
            parts.Add($"{show} has {n}");
        }
        if (parts.Count == 0) return null;
        if (total == 0)
            return $"None of the shows here has a {name} episode yet. " + (slot.HolidayMode == HolidayMode.Only ? "This slot would have nothing to play." : "The slot will play regular episodes until some are labelled.") + " Confirm or add holiday episodes on the Needs attention or Library page.";
        return $"{name} episodes: {string.Join(", ", parts)}.";
    }

    private string LengthWords(string show) => AverageOf(show) is { } ms ? $"about {(ms + 30_000) / 60_000} min" : "";

    private void SetHoldGrid(ChannelConfig ch, ChangeEventArgs e) => holdGrid[ch.Number] = e.Value?.ToString() ?? "true";

    private string HoldGrid(ChannelConfig ch) => holdGrid.TryGetValue(ch.Number, out string? v) ? v : (ch.Gap.HoldGrid ? "true" : "false");

    private void SetView(string v)
    {
        view = v;
        if (cfg is null) return;
        cfg.Ui.ScheduleView = v;
        try { Config.Save(cfg); } catch { /* preference only */ }
    }

    private void Toggle(string number)
    {
        if (!expanded.Remove(number)) expanded.Add(number);
    }

    private void AddSlot(DayPlan plan)
    {
        string nextTime = plan.Slots.Count == 0 ? "06:00" : plan.Slots.Max(s => s.StartTime).AddHours(1).ToString("HH:mm");
        plan.Slots.Add(new SlotConfig { Time = nextTime, Shows = [shows.FirstOrDefault() ?? ""], Order = "chronological" });
    }

    private static string? NullIfEmpty(object? value)
    {
        string? s = value?.ToString();
        return string.IsNullOrEmpty(s) ? null : s;
    }

    private void Save()
    {
        if (cfg is null) return;
        problems = [];
        foreach (var ch in cfg.Channels)
        {
            ch.Gap.HoldGrid = HoldGrid(ch) == "true";
            foreach (var plan in ch.Plans)
            {
            string where = ch.Plans.Count > 1 ? $"Channel {ch.Number}, {plan.Name}" : $"Channel {ch.Number}";
            if (plan.Slots.Count == 0) problems.Add($"{where} needs at least one time slot.");
            foreach (var s in plan.Slots)
            {
                if (s.Shows.Count == 0 || s.Shows.All(string.IsNullOrWhiteSpace)) problems.Add($"Channel {ch.Number}: the {s.Time} slot has no show.");
                foreach (string name in s.Shows)
                {
                    if (string.IsNullOrWhiteSpace(name)) { if (s.Shows.Count > 1) problems.Add($"Channel {ch.Number}: the {s.Time} slot has an empty show row. Pick a show or remove the row."); }
                    else if (!shows.Any(x => string.Equals(x, name.Trim(), StringComparison.OrdinalIgnoreCase)))
                        problems.Add($"Channel {ch.Number}: \"{name}\" isn't a show in the catalog. Pick one from the list, or scan the folder that holds it.");
                }
                if (s.Shows.Count(n => !string.IsNullOrWhiteSpace(n)) != s.Shows.Where(n => !string.IsNullOrWhiteSpace(n)).Distinct(StringComparer.OrdinalIgnoreCase).Count())
                    problems.Add($"Channel {ch.Number}: the {s.Time} slot lists the same show twice.");
                if (!TimeOnly.TryParse(s.Time, out _)) problems.Add($"Channel {ch.Number}: \"{s.Time}\" isn't a valid time.");
                if (AdMode(s) == "only" && (s.Ads is null || s.Ads.Only.Count == 0))
                    problems.Add($"Channel {ch.Number}: the {s.Time} slot says \"only these categories\" but no category is ticked. Tick one, or choose Any category.");
                if (AdMode(s) == "never" && (s.Ads is null || s.Ads.Never.Count == 0))
                    problems.Add($"Channel {ch.Number}: the {s.Time} slot says \"any except these categories\" but no category is ticked. Tick one, or choose Any category.");
                if (s.Ads is { EraMode: EraMode.Decades, Decades.Count: 0 })
                    problems.Add($"Channel {ch.Number}: the {s.Time} slot says \"only these decades\" but no decade is ticked. Tick one, or choose Any year.");
            }
            foreach (string t in plan.Slots.GroupBy(s => s.Time).Where(g => g.Count() > 1).Select(g => g.Key))
                problems.Add($"{where}: two slots start at {t}. Give them different times.");
            }
        }
        if (problems.Count > 0) { notice = "Not saved yet. Fix these first:"; return; }

        try
        {
            foreach (var s in cfg.Channels.SelectMany(c => c.Plans.SelectMany(p => p.Slots)))
                s.Shows = s.Shows.Where(n => !string.IsNullOrWhiteSpace(n)).Select(n => n.Trim()).ToList();
            cfg.Validate();
            Config.Save(cfg);
            var notes = cfg.Channels.SelectMany(c => c.Plans.SelectMany(p => p.Slots).Select(s => BlockAdvisor.Advice(c, s, AverageOf))).Where(a => a is not null).ToList();
            notice = "Saved. Go to Build to preview or put it on air." + (notes.Count > 0 ? " One thing to know: " + string.Join(" ", notes) : "");
        }
        catch (Exception ex)
        {
            notice = "Couldn't save: " + ex.Message;
        }
    }

    private static string PadWords(string pad) => pad.Trim().ToLowerInvariant() switch
    {
        "30" => "the half hour",
        "60" => "the hour",
        "5" => "the next 5 minutes",
        "10" => "the next 10 minutes",
        "none" or "0" => "when the show ends",
        _ => pad,
    };
}
