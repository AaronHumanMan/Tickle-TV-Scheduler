@page "/build"
@using TickleTV.Scheduler.Core.Config
@using TickleTV.Scheduler.Core.Engine
@using TickleTV.Scheduler.Web.Services
@inject ConfigStore Config
@inject JobRunner Jobs
@inject NightlyBuilder Nightly
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Build the schedule</PageTitle>

<PageHead Title="Build the schedule" Code="40274-09">Building turns your daily schedule into the next day of television for ErsatzTV: episodes in order, commercial breaks between scenes, bumpers, and every show ending on time. Preview first to see the plan; nothing changes until you press Build.</PageHead>

<section class="lower">
<SideRail Links="rail" />
<div class="lower-panels">

@if (cfg is null || cfg.Channels.Count == 0)
{
    <div class="card warn">
        <h2>No schedule yet</h2>
        <p>There's no channel schedule to build from. Go to <a href="schedule">Schedule</a> and add a time slot.</p>
        <a class="button primary" href="schedule" data-sound="keyok">Go to Schedule</a>
    </div>
}
else
{
    <div class="card">
        <h2>Your daily schedule</h2>
        <div class="view-toggle">
            <span class="muted">Show as</span>
            <button class="chip @(view == "grid" ? "active" : "")" data-sound="keyok" @onclick="@(() => SetView("grid"))">Guide grid</button>
            <button class="chip @(view == "list" ? "active" : "")" data-sound="keyok" @onclick="@(() => SetView("list"))">Lists</button>
        </div>
        @if (view == "grid")
        {
            <ScheduleGrid Channels="cfg.Channels" PlanOf="TodayPlan" />
            @if (cfg.Channels.Any(c => c.Plans.Count > 1)) { <p class="muted">Showing today's day plan for each channel. The <a href="calendar">Calendar</a> page says which plan other dates use.</p> }
        }
        else
        {
            @foreach (var ch in cfg.Channels)
            {
                <h3>Channel @ch.Number: @ch.Name@(ch.Plans.Count > 1 ? $" (today: {TodayPlan(ch).Name})" : "")</h3>
                <table class="table compact">
                    <thead><tr><th>From</th><th>Show</th><th>Order</th><th>Ends on</th></tr></thead>
                    <tbody>
                    @foreach (var s in TodayPlan(ch).Slots.OrderBy(s => s.StartTime))
                    {
                        <tr><td>@s.StartTime.ToString("h:mm tt")</td><td>@s.Label@(s.ShowList.Count > 1 ? " (take turns)" : "")@(s.HolidayWords is { } hw ? $" ({hw})" : "")</td><td>@(s.OrderMode == OrderMode.Shuffle ? "shuffled, no repeats" : "in order")</td><td>@PadWords(s.Pad ?? ch.Defaults.Pad)</td></tr>
                    }
                    </tbody>
                </table>
            }
        }
        <p class="muted">ErsatzTV lineup: @cfg.ResolvePath(cfg.Next.Lineup) &middot; <a href="schedule">Change the schedule</a></p>
    </div>

    <div class="card">
        <h2>Preview, then build</h2>
        <p><strong>Preview</strong> shows what the schedule would look like without changing anything. <strong>Build</strong> writes it for ErsatzTV. A build joins in at the end of whatever is playing now, so the show on air is never interrupted.</p>
        <label class="days">How many days to build?
            <input type="number" min="1" max="@BuildOptions.MaxDays" @bind="days" /> <span class="muted">(1 to @BuildOptions.MaxDays; one day is plenty if you build every day)</span>
        </label>
        <div class="actions">
            <button class="button" data-sound="keyok" disabled="@Jobs.IsBusy" @onclick="Preview">Preview @DaysWord</button>
            <button class="button primary" data-sound="computerbeep_34" disabled="@Jobs.IsBusy" @onclick="BuildNow">Build @DaysWord and send to ErsatzTV</button>
        </div>
        @if (!string.IsNullOrEmpty(notice)) { <div class="notice">@notice</div> }
    </div>

    <div class="card">
        <h2>Build automatically every night</h2>
        <p>While Tickle TV is running (look for its icon by the clock), it can build the next days of television on its own, so the channel never runs out even if you forget. If the computer was off at build time, it catches up as soon as Tickle TV starts again.</p>
        <div class="form">
            <label class="check"><input type="checkbox" @bind="autoEnabled" /> Build on its own every night</label>
            <label>At what time <input type="time" @bind="autoTime" /></label>
            <label>How many days each time <input type="number" min="1" max="@BuildOptions.MaxDays" @bind="autoDays" /></label>
            <button class="button primary" data-sound="keyok" @onclick="SaveAuto">Save</button>
        </div>
        <p class="muted">@AutoWords()</p>
        @if (!string.IsNullOrEmpty(autoNotice)) { <div class="notice">@autoNotice</div> }
        @if (Nightly.Record.FinishedAt is { } finished)
        {
            <p class="@(Nightly.Record.Failed ? "why" : "summary")">Last automatic build: @finished.ToString("dddd d MMMM, h:mm tt"). @Nightly.Record.Summary</p>
        }
        else if (Nightly.Record.StartedAt is not null)
        {
            <p class="muted">The automatic build is running now.</p>
        }
        <div class="actions">
            <button class="button" data-sound="computerbeep_34" disabled="@Jobs.IsBusy" @onclick="Nightly.RunNow">Run the automatic build now</button>
        </div>
    </div>
}

<JobPanel />
</div>
</section>

@code {
    private static readonly IReadOnlyList<SideRail.Link> rail =
    [
        new("Schedule", "schedule", 1),
        new("Calendar", "calendar", 2),
        new("Channels", "channels", 3),
        new("Help", "help"),
    ];
    private static DayPlan TodayPlan(ChannelConfig ch) => PlanCalendar.PlanFor(ch, DateOnly.FromDateTime(DateTime.Now));

    private SchedulerConfig? cfg;
    private string? notice;
    private int days = 1;
    private string view = "list";
    private bool autoEnabled = true;
    private TimeOnly autoTime = new(3, 0);
    private int autoDays = 2;
    private string? autoNotice;

    private void SetView(string v)
    {
        view = v;
        if (cfg is null) return;
        cfg.Ui.BuildView = v;
        try { Config.Save(cfg); } catch { /* preference only */ }
    }
    private string DaysWord => days <= 1 ? "the next 24 hours" : $"the next {Math.Clamp(days, 1, BuildOptions.MaxDays)} days";

    protected override void OnInitialized()
    {
        Jobs.Changed += OnJobChanged;
        Nightly.Changed += OnJobChanged;
        try { cfg = Config.Load(); view = cfg.Ui.BuildView == "grid" ? "grid" : "list"; LoadAuto(cfg.AutoBuild); }
        catch (Exception ex) when (ex is InvalidDataException or FileNotFoundException) { cfg = null; notice = ex.Message; }
    }

    public void Dispose() { Jobs.Changed -= OnJobChanged; Nightly.Changed -= OnJobChanged; }

    private void LoadAuto(AutoBuildConfig a)
    {
        autoEnabled = a.Enabled;
        autoTime = a.TimeOfDay;
        autoDays = AutoBuild.ClampDays(a.Days);
    }

    private void SaveAuto()
    {
        try
        {
            SchedulerConfig current = Config.LoadLoose();
            current.AutoBuild = new AutoBuildConfig { Enabled = autoEnabled, Time = autoTime.ToString("HH:mm"), Days = AutoBuild.ClampDays(autoDays) };
            Config.Save(current);
            if (cfg is not null) cfg.AutoBuild = current.AutoBuild;
            LoadAuto(current.AutoBuild);
            autoNotice = autoEnabled ? "Saved. Tickle TV has to be running for the automatic build to happen." : "Saved. Automatic building is off.";
        }
        catch (Exception ex) { autoNotice = "Couldn't save: " + ex.Message; }
    }

    private string AutoWords()
    {
        var a = cfg?.AutoBuild ?? new AutoBuildConfig { Enabled = autoEnabled, Time = autoTime.ToString("HH:mm"), Days = autoDays };
        if (!a.Enabled) return "Automatic building is off. Press Build yourself whenever you change the schedule.";
        DateTime? next = Nightly.NextRun(a);
        if (next is null) return "";
        string when = next.Value <= DateTime.Now ? "as soon as nothing else is running" : next.Value.ToString("dddd 'at' h:mm tt");
        return $"Next automatic build: {when}, writing the next {a.Days} day{(a.Days == 1 ? "" : "s")}.";
    }
    private void OnJobChanged() => _ = InvokeAsync(StateHasChanged);

    private void Preview() => Start(dryRun: true);
    private void BuildNow() => Start(dryRun: false);

    private void Start(bool dryRun)
    {
        if (cfg is null) return;
        days = Math.Clamp(days, 1, BuildOptions.MaxDays);
        try { Jobs.StartBuild(cfg, new BuildOptions { DryRun = dryRun, Hours = days * 24 }); notice = null; }
        catch (InvalidOperationException ex) { notice = ex.Message; }
    }

    private static string PadWords(string pad) => pad.Trim().ToLowerInvariant() switch
    {
        "30" => "the half hour",
        "60" => "the hour",
        "5" => "the next 5 minutes",
        "10" => "the next 10 minutes",
        "none" or "0" => "when the show ends",
        _ => pad,
    };
}
