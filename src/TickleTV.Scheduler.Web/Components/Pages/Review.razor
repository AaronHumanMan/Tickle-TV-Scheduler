@page "/review"
@using TickleTV.Scheduler.Core.Catalog
@using TickleTV.Scheduler.Web.Services
@inject CatalogAccess Catalog
@inject ConfigStore Config
@rendermode InteractiveServer

<PageTitle>Needs attention</PageTitle>

<h1>Needs attention</h1>
<p class="lead">These files were scanned, but I couldn't tell what they are or couldn't label them well. Click <strong>Watch</strong> to open a file in your video player, then <strong>Edit</strong> to say what it is. To label several similar files at once, tick their boxes and use the panel that appears. You can stop any time; nothing here is required.</p>

<div class="filters">
    <button class="chip @(filter is null ? "active" : "")" @onclick="() => SetFilter(null)">All (@counts.Where(kv => kv.Key is not (AttentionReason.NoChapters or AttentionReason.HolidayGuess)).Sum(kv => kv.Value))</button>
    @foreach (var kv in counts.Where(kv => kv.Value > 0))
    {
        <button class="chip @(filter == kv.Key ? "active" : "")" @onclick="() => SetFilter(kv.Key)">@LibraryActions.ReasonTitle(kv.Key) (@kv.Value)</button>
    }
</div>

@if (entries.Count > 0)
{
    <p class="muted"><a class="link" href="@("/export/review.csv" + (filter is null ? "" : "?reason=" + filter))" target="_blank">Export this list as a spreadsheet (.csv)</a>
    &middot; <label class="inline">Per page <select value="@PageSize" @onchange="SetPageSize"><option value="50">50</option><option value="100">100</option><option value="150">150</option><option value="200">200</option></select></label></p>
}

@if (noSidecars && counts.GetValueOrDefault(AttentionReason.EpisodeDetails) + counts.GetValueOrDefault(AttentionReason.Unknown) > 0)
{
    <p class="notice"><strong>A shortcut for episodes:</strong> none of your videos has a <em>.nfo</em> details file next to it. If you use Kodi, Jellyfin, Emby or tinyMediaManager, let it look up your shows: it writes those files, and the next scan here reads them and fills in the show, season, episode and air date for you. See <a href="help">Help</a> under "How files get sorted".</p>
}

<ItemList Items="entries" NoteFor="NoteFor" EmptyTitle="Nothing to look at" EmptyText="Every file in this list has been labeled." OnChanged="Reload" />

@if (entries.Count >= PageSize)
{
    <p class="muted">Showing the first @PageSize. Label some and press <button class="link" @onclick="Reload">refresh</button> to see more.</p>
}

@code {
    private int PageSize = 50;
    private AttentionReason? filter;
    private IReadOnlyDictionary<AttentionReason, int> counts = new Dictionary<AttentionReason, int>();
    private List<CatalogEntry> entries = [];
    private bool noSidecars;
    private readonly Dictionary<long, AttentionReason> reasons = new();

    protected override void OnInitialized()
    {
        PageSize = UiPrefs.PageSize(Config);
        Reload();
    }

    private void SetPageSize(ChangeEventArgs e)
    {
        PageSize = UiPrefs.SavePageSize(Config, e.Value);
        Reload();
    }

    private void Reload()
    {
        if (!Catalog.CatalogExists) { entries = []; return; }
        counts = Catalog.Run(db => db.CountNeedingAttention());
        noSidecars = Catalog.Run(db => db.CountWithSidecar()) == 0;
        var rows = Catalog.Run(db => db.ListNeedingAttention(filter, PageSize));
        reasons.Clear();
        foreach (var r in rows) reasons[r.Entry.Item.Id] = r.Reason;
        entries = rows.Select(r => r.Entry).ToList();
    }

    private void SetFilter(AttentionReason? reason)
    {
        filter = reason;
        Reload();
    }

    private string? NoteFor(long id) => reasons.TryGetValue(id, out var r) ? LibraryActions.ReasonText(r) : null;
}
