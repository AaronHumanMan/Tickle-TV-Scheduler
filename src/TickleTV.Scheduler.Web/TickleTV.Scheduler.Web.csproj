<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TickleTV.Scheduler.Core\TickleTV.Scheduler.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Windows only: the app lives in the tray by the clock and opens in the browser; it has no console window. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <Version>0.1.0</Version>
    <Product>Tickle TV Scheduler</Product>
    <AssemblyTitle>Tickle TV Scheduler</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms is used in one file, with its names written out, so its namespaces stay out of the Razor pages. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <None Update="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
