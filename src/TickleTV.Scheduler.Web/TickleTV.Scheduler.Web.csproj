<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- 0 to 9: how hard the GC works to give memory back. 5 trades a little CPU for a smaller idle footprint. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TickleTV.Scheduler.Core\TickleTV.Scheduler.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Windows only: the app lives in the tray by the clock and opens in the browser; it has no console window. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Stays a console-type project because the Web SDK only ships the Blazor script for OutputType Exe;
         the launcher is still built as a windowed program, so no console window appears. -->
    <OutputType>Exe</OutputType>
    <_UseWindowsGraphicalUserInterface>true</_UseWindowsGraphicalUserInterface>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- One person, one tray app: workstation garbage collection and conserve-memory keep the working set small,
         where the web-server default (server GC) happily holds gigabytes of freed memory in reserve. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <Version>0.1.1</Version>
    <Product>Tickle TV Scheduler</Product>
    <AssemblyTitle>Tickle TV Scheduler</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms is used in one file, with its names written out, so its namespaces stay out of the Razor pages. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <None Update="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
